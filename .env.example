TUXNEWS_ENVIRONMENT=local
TUXNEWS_ALLOW_PUBLIC_REGISTRATION=false
TUXNEWS_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
TUXNEWS_REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
TUXNEWS_ALLOWED_HOSTS=["localhost","127.0.0.1"]
TUXNEWS_ALLOWED_CORS_ORIGINS=["http://localhost:5173"]
TUXNEWS_HSTS_ENABLED=false
TUXNEWS_OBSERVABILITY_HASH_SALT=replace-with-at-least-32-random-characters
TUXNEWS_HEALTH_CHECK_TIMEOUT_SECONDS=2
TUXNEWS_INGESTION_POLL_INTERVAL_SECONDS=900
TUXNEWS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TUXNEWS_EMBEDDING_VERSION=v1
TUXNEWS_EMBEDDING_DIMENSION=384
TUXNEWS_QUOTA_POLICY_VERSION=quota-v1
TUXNEWS_QUOTA_REQUESTS_PER_WINDOW=120
TUXNEWS_QUOTA_SCOPE_REQUESTS_PER_WINDOW=60
TUXNEWS_QUOTA_OPERATION_REQUESTS_PER_WINDOW=60
TUXNEWS_QUOTA_PROVIDER_REQUESTS_PER_WINDOW=60
TUXNEWS_QUOTA_WINDOW_SECONDS=60
TUXNEWS_QUOTA_DAILY_COST_USD=10
TUXNEWS_QUOTA_RESERVATION_TTL_SECONDS=300
TUXNEWS_QUOTA_FAIL_OPEN=true
TUXNEWS_LLM_INPUT_COST_PER_MILLION_USD=0
TUXNEWS_LLM_OUTPUT_COST_PER_MILLION_USD=0
TUXNEWS_LLM_COST_CURRENCY=USD
TUXNEWS_LLM_USAGE_RETENTION_DAYS=90
TUXNEWS_LLM_DEFAULT_PROFILE=eco
TUXNEWS_LLM_ECO_MODEL=ollama/llama3.2:3b
TUXNEWS_LLM_CLOUD_MODEL=openai/gpt-4o-mini
TUXNEWS_LLM_HYBRID_MODEL=openai/gpt-4o-mini
OLLAMA_API_BASE=http://ollama:11434
TUXNEWS_OLLAMA_PORT=11434
TUXNEWS_AUDIT_RETENTION_DAYS=180
POSTGRES_USER=tuxnews
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=tuxnews
